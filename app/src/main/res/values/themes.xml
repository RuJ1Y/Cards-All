<resources>
    <style name="Base.Theme.Cards" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/ui_btn</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/ui_btn</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Cards" parent="Base.Theme.Cards" />

    <style name="Theme.Cards.NoPreview" parent="Theme.Cards">
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="Theme.Cards.Splash" parent="Theme.Cards.NoPreview">
        <item name="android:windowBackground">@color/ui_bg</item>
    </style>
</resources>
